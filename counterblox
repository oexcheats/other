local function destroyAura(auraName)
	if (auras[auraName] and auras[auraName].Instance) then
		if (type(auras[auraName].Instance) == "table") then
			for _, instance in pairs(auras[auraName].Instance) do
				if (instance and instance.Parent) then
					instance:Destroy();
				end
			end
		elseif (auras[auraName].Instance and auras[auraName].Instance.Parent) then
			auras[auraName].Instance:Destroy();
		end
		auras[auraName].Instance = nil;
	end
end
local function updateAuras()
	if not localPlayer.Character then
		return;
	end
	for auraName, auraData in pairs(auras) do
		if auraData.Enabled then
			if not auraData.Instance then
				if (auraName == "AmbientAura") then
					auras[auraName].Instance = createAmbientAura(localPlayer.Character);
				elseif (auraName == "AngelWings") then
					auras[auraName].Instance = createAngelWings(localPlayer.Character);
				elseif (auraName == "Enchanted") then
					auras[auraName].Instance = createEnchanted(localPlayer.Character);
				elseif (auraName == "Halo") then
					auras[auraName].Instance = createHalo(localPlayer.Character);
				elseif (auraName == "Sakura") then
					auras[auraName].Instance = createSakura(localPlayer.Character);
				elseif (auraName == "Tornado") then
					auras[auraName].Instance = createTornado(localPlayer.Character);
				end
			end
		else
			destroyAura(auraName);
		end
	end
end
