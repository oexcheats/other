local function UpdateOffscreenArrows()
	if not offscreenArrows.enabled then
		for player, arrowData in pairs(offscreenArrows.arrows) do
			pcall(function()
				if arrowData.fill then
					arrowData.fill:Remove();
				end
				if arrowData.outline then
					arrowData.outline:Remove();
				end
			end);
		end
		offscreenArrows.arrows = {};
		return;
	end
	local viewport = currentCamera.ViewportSize;
	local screenCenter = Vec2(viewport.X / 2, viewport.Y / 2);
	local arrowSize = offscreenArrows.size;
	local arrowColor = offscreenArrows.color;
	local arrowPercentage = offscreenArrows.radius;
	local camP = currentCamera.CFrame.p;
	local flatCF = CFrame.lookAt(camP, camP + (currentCamera.CFrame.LookVector * Vector3.new(1, 0, 1)));
	local activePlayers = {};
	for _, player in pairs(players:GetPlayers()) do
		if ((player ~= localPlayer) and esp.HasCharacter(player) and esp.IsEnemy(player)) then
			local hrp = player.Character.HumanoidRootPart;
			local _, onScreen = currentCamera:WorldToViewportPoint(hrp.Position);
			if not onScreen then
				activePlayers[player] = true;
				local pos = flatCF:PointToObjectSpace(hrp.Position);
				local angle = math.atan2(pos.Z, pos.X);
				local cx = math.cos(angle);
				local sy = math.sin(angle);
				local cx1 = math.cos(angle + (math.pi / 2));
				local sy1 = math.sin(angle + (math.pi / 2));
				local cx2 = math.cos(angle + ((math.pi / 2) * 3));
				local sy2 = math.sin(angle + ((math.pi / 2) * 3));
				local arrowOrigin = screenCenter + Vec2(cx * arrowPercentage, sy * arrowPercentage);
				local pA = arrowOrigin + Vec2(arrowSize * 2 * cx, arrowSize * 2 * sy);
				local pB = arrowOrigin + Vec2(arrowSize * cx1, arrowSize * sy1);
				local pC = arrowOrigin + Vec2(arrowSize * cx2, arrowSize * sy2);
				if not offscreenArrows.arrows[player] then
					local outlineTri = Drawing.new("Triangle");
					outlineTri.Filled = true;
					outlineTri.Visible = false;
					local fillTri = Drawing.new("Triangle");
					fillTri.Filled = true;
					fillTri.Visible = false;
					offscreenArrows.arrows[player] = {outline=outlineTri,fill=fillTri};
				end
				local arrowData = offscreenArrows.arrows[player];
				arrowData.fill.PointA = pA;
				arrowData.fill.PointB = pB;
				arrowData.fill.PointC = pC;
				arrowData.fill.Color = arrowColor;
				arrowData.fill.Transparency = 0.65;
				arrowData.fill.Visible = true;
				arrowData.outline.PointA = pA;
